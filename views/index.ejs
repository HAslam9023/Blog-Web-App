<%- include("partials/header.ejs") %>
<main>
    <form action="/new-post" method="POST">
        <label>
            <textarea name="post" rows="10" cols="100">Write your post here.</textarea>
        </label>
        <input type="submit" class="btn">
    </form>

    <% if (locals.posts && locals.dateTimes) { %>
        <hr>

        <h2>Posts</h2>
        <% for (let i = 0; i < locals.posts.length; i++) { %>
            <div class="posts">
                <p><%= locals.dateTimes[i] %>:</p>
                <p><%= locals.posts[i] %></p>
                <div>
                    <form action="/edit" method="POST">
                        <input type="hidden" name="post"
                               value="<%= locals.posts[i] %>">
                        <input type="hidden" name="postID"
                               value="<%= i %>">
                        <button type="submit" class="btn">Edit</button>
                    </form>
                    <form action="/delete" method="POST">
                        <input type="hidden" name="postID" value="<%= i %>">
                        <button type="submit" class="btn">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    <% } %>
<%- include("partials/footer.ejs") %>